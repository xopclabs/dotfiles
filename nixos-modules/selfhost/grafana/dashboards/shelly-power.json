    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "telemetry-postgres"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH per_device AS (\n  SELECT\n    split_part(topic, '/', 3) AS device,\n    (max((payload->'aenergy'->>'total')::double precision)\n      - min((payload->'aenergy'->>'total')::double precision)) / 1000.0 AS kwh\n  FROM mqtt_messages\n  WHERE $__timeFilter(received_at)\n    AND topic LIKE 'apartment/%/%/status/switch:0'\n    AND payload ? 'aenergy'\n  GROUP BY 1\n)\nSELECT COALESCE(sum(GREATEST(kwh, 0)), 0) AS \"Selected\" FROM per_device"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Energy used during the currently selected dashboard time range.",
        "id": 2,
        "links": [],
        "title": "Selected",
