    "panel-7": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "telemetry-postgres"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH bounds AS (\n  SELECT\n    ((CURRENT_TIMESTAMP AT TIME ZONE 'Europe/Madrid')::date - 13) AS first_day,\n    (CURRENT_TIMESTAMP AT TIME ZONE 'Europe/Madrid')::date AS today,\n    CURRENT_TIMESTAMP AS now_ts\n), per_device_day AS (\n  SELECT\n    (received_at AT TIME ZONE 'Europe/Madrid')::date AS local_day,\n    split_part(topic, '/', 3) AS device,\n    GREATEST(\n      max((payload->'aenergy'->>'total')::double precision)\n      - min((payload->'aenergy'->>'total')::double precision),\n      0\n    ) / 1000.0 AS kwh\n  FROM mqtt_messages, bounds\n  WHERE received_at >= (first_day::timestamp AT TIME ZONE 'Europe/Madrid')\n    AND received_at <= now_ts\n    AND topic LIKE 'apartment/%/%/status/switch:0'\n    AND payload ? 'aenergy'\n  GROUP BY 1, 2\n), days AS (\n  SELECT generate_series(first_day, today, interval '1 day')::date AS day\n  FROM bounds\n)\nSELECT\n  CASE\n    WHEN days.day = bounds.today THEN to_char(days.day, 'Dy DD') || ' · now'\n    ELSE to_char(days.day, 'Dy DD')\n  END AS \"Day\",\n  CASE\n    WHEN ${outlet_breakdown:raw} THEN\n      COALESCE((\n        SELECT jsonb_object_agg(\n          p.device,\n          round(p.kwh::numeric, 2)\n          ORDER BY p.device\n        )\n        FROM per_device_day p\n        WHERE p.local_day = days.day\n      ), '{}'::jsonb)::text\n    ELSE\n      jsonb_build_object(\n        'All outlets',\n        round(COALESCE((\n          SELECT sum(p.kwh)\n          FROM per_device_day p\n          WHERE p.local_day = days.day\n        ), 0)::numeric, 2)\n      )::text\n  END AS \"Series\"\nFROM days\nCROSS JOIN bounds\nORDER BY days.day"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": [
              {
                "kind": "Transformation",
                "group": "extractFields",
                "spec": {
                  "options": {
                    "source": "Series",
                    "format": "json",
                    "replace": false
                  }
                }
              },
              {
                "kind": "Transformation",
                "group": "organize",
                "spec": {
                  "options": {
                    "excludeByName": {
                      "Series": true
                    },
                    "indexByName": {},
                    "renameByName": {}
                  }
                }
              }
            ]
          }
        },
