    "panel-4": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "telemetry-postgres"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH bounds AS (\n  SELECT\n    to_timestamp(${__from} / 1000.0) - interval '1 day' AS start_at,\n    to_timestamp(${__to} / 1000.0) - interval '1 day' AS end_at\n), per_device AS (\n  SELECT\n    split_part(topic, '/', 3) AS device,\n    (max((payload->'aenergy'->>'total')::double precision)\n      - min((payload->'aenergy'->>'total')::double precision)) / 1000.0 AS kwh\n  FROM mqtt_messages, bounds\n  WHERE received_at >= bounds.start_at\n    AND received_at <= bounds.end_at\n    AND topic LIKE 'apartment/%/%/status/switch:0'\n    AND payload ? 'aenergy'\n  GROUP BY 1\n)\nSELECT COALESCE(sum(GREATEST(kwh, 0)), 0) AS \"Prev day\" FROM per_device"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Energy used during the immediately preceding time window of the same duration as the selected range.",
        "id": 4,
        "links": [],
        "title": "Prev day",
        "vizConfig": {
          "group": "stat",
          "kind": "VizConfig",
          "spec": {
