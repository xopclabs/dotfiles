            }
          },
          "version": "13.1.4"
        }
      }
    },
    "panel-5": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "telemetry-postgres"
                    },
                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "WITH bounds AS (\n  SELECT\n    to_timestamp(${__from} / 1000.0) AS cur_start,\n    to_timestamp(${__to} / 1000.0) AS cur_end,\n    to_timestamp(${__from} / 1000.0) - interval '1 day' AS prev_start,\n    to_timestamp(${__to} / 1000.0) - interval '1 day' AS prev_end\n), per_device AS (\n  SELECT\n    split_part(topic, '/', 3) AS device,\n    (max((payload->'aenergy'->>'total')::double precision) FILTER (\n       WHERE received_at >= bounds.cur_start AND received_at <= bounds.cur_end)\n     - min((payload->'aenergy'->>'total')::double precision) FILTER (\n       WHERE received_at >= bounds.cur_start AND received_at <= bounds.cur_end)) / 1000.0 AS cur_kwh,\n    (max((payload->'aenergy'->>'total')::double precision) FILTER (\n       WHERE received_at >= bounds.prev_start AND received_at <= bounds.prev_end)\n     - min((payload->'aenergy'->>'total')::double precision) FILTER (\n       WHERE received_at >= bounds.prev_start AND received_at <= bounds.prev_end)) / 1000.0 AS prev_kwh\n  FROM mqtt_messages, bounds\n  WHERE received_at >= bounds.prev_start\n    AND received_at <= bounds.cur_end\n    AND topic LIKE 'apartment/%/%/status/switch:0'\n    AND payload ? 'aenergy'\n  GROUP BY 1\n), totals AS (\n  SELECT\n    COALESCE(sum(GREATEST(cur_kwh, 0)), 0) AS cur_kwh,\n    COALESCE(sum(GREATEST(prev_kwh, 0)), 0) AS prev_kwh\n  FROM per_device\n)\nSELECT COALESCE(\n  CASE WHEN prev_kwh > 0\n    THEN (cur_kwh - prev_kwh) / prev_kwh * 100.0\n    ELSE 0.0\n  END,\n  0.0\n) AS \"Δ vs prev\"\nFROM totals"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Percent change between the selected range and the immediately preceding window of the same duration. Negative means lower consumption.",
