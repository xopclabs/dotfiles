          "description": "Percent difference between selected total kWh and the average of complete, equal-length historical periods. Negative means lower consumption. No comparison if no historical period has complete boundary coverage, if selected data is missing, or if the historical average is zero.",
          "id": 5,
          "links": [],
          "title": "Δ vs avg",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 1,
                  "unit": "string",
                  "noValue": "No comparison",
                  "color": {
                    "mode": "thresholds"
                  },
                  "mappings": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": { "text": "No comparison", "color": "white" }
                      }
                    },
                    {
                      "type": "regex",
                      "options": {
                        "pattern": "/^-.*%$/",
                        "result": { "color": "green" }
                      }
                    },
                    {
                      "type": "regex",
                      "options": {
                        "pattern": "/^\\+.*%$/",
                        "result": { "color": "red" }
                      }
                    },
                    {
                      "type": "regex",
                      "options": {
                        "pattern": "^0\\.0%$",
                        "result": { "color": "white" }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "white",
                        "value": -1e+308
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "^Δ vs avg$",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value",
                "wideLayout": true
              }
            },
            "version": "13.1.4"
          }
