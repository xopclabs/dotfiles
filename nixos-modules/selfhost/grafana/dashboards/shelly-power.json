                    "group": "grafana-postgresql-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "format": "time_series",
                      "rawQuery": true,
                      "rawSql": "WITH per_device AS (\n  SELECT\n    $__timeGroupAlias(received_at, $__interval),\n    split_part(topic, '/', 3) AS device,\n    avg((payload->>'apower')::double precision) AS watts\n  FROM mqtt_messages\n  WHERE $__timeFilter(received_at)\n    AND topic LIKE 'apartment/%/%/status/switch:0'\n    AND payload ? 'apower'\n  GROUP BY 1, 2\n)\nSELECT\n  time,\n  CASE WHEN ${outlet_breakdown:raw} THEN device ELSE 'All outlets' END AS metric,\n  sum(watts) AS value\nFROM per_device\nGROUP BY 1, 2\nORDER BY 1, 2"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
