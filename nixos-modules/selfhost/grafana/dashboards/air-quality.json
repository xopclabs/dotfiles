          "title": "CO₂ now",
          "description": "Most recent CO₂ reading. Green <1000 ppm; yellow 1000–1499; orange 1500–1999; red ≥2000 ppm.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "telemetry-postgres"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT received_at AS time, (payload->>'co2_ppm')::double precision AS value FROM mqtt_messages WHERE topic = 'apartment/room/air-quality' AND payload ? 'co2_ppm' ORDER BY received_at DESC LIMIT 1"
                      }
