{
  "id": "/",
  "name": "Catprinter",
  "short_name": "Catprinter",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eceff4",
  "theme_color": "#eceff4",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*", ".heic", ".heif", ".hif"]
        }
      ]
    }
  },
  "icons": [
    { "src": "/ui/static/icon.png", "sizes": "192x192", "type": "image/png" },
    {
      "src": "/ui/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
