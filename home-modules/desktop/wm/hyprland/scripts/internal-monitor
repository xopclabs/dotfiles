#!/usr/bin/env bash

# Toggle internal monitor on/off
# Usage: internal-monitor [on|off|toggle|status|apply|watch]
# Default action is toggle
#
# on/off/toggle is persisted. With no usable external the panel is forced
# on at 0x0 (preference unchanged) so it comes back after unplug.

set -euo pipefail

INTERNAL_DESC="@INTERNAL_MONITOR@"
INTERNAL_MODE="@INTERNAL_MODE@"
INTERNAL_SCALE="@INTERNAL_SCALE@"
INTERNAL_POSITION="@INTERNAL_POSITION@"
INTERNAL_TRANSFORM="@INTERNAL_TRANSFORM@"
INTERNAL_CONNECTOR="@INTERNAL_CONNECTOR@"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/internal-monitor"
STATE_FILE="$STATE_DIR/preference"
WATCH_LOCK="$STATE_DIR/watch.lock"

get_monitor_name() {
    local name
    name=$(hyprctl monitors all -j 2>/dev/null | jq -r --arg desc "$INTERNAL_DESC" \
        '.[] | select(.description == $desc) | .name' || true)
    if [[ -n "$name" && "$name" != "null" ]]; then
        printf '%s\n' "$name"
        return 0
    fi
    if [[ -n "$INTERNAL_CONNECTOR" ]]; then
        printf '%s\n' "$INTERNAL_CONNECTOR"
        return 0
    fi
    return 1
}

is_enabled() {
    local disabled
    disabled=$(hyprctl monitors all -j 2>/dev/null | jq -r --arg desc "$INTERNAL_DESC" \
        '.[] | select(.description == $desc) | .disabled' || true)
    [[ "$disabled" == "false" ]]
}

internal_xy() {
    hyprctl monitors all -j 2>/dev/null | jq -r --arg desc "$INTERNAL_DESC" \
        '.[] | select(.description == $desc) | "\(.x)x\(.y)"' || true
}

# Physically connected non-internal DRM connectors.
drm_has_external() {
    local f base conn
    shopt -s nullglob
    for f in /sys/class/drm/card*-*/status; do
        base=$(basename "$(dirname "$f")")
        conn="${base#card*-}"
        case "$conn" in
            eDP-*|Writeback-*|DSI-*) continue ;;
        esac
        if [[ $(<"$f") == "connected" ]]; then
            shopt -u nullglob
            return 0
        fi
    done
    shopt -u nullglob
    return 1
}

# First Hyprland-enabled output that isn't the internal panel or FALLBACK.
get_other_monitor() {
    hyprctl monitors -j 2>/dev/null | jq -r --arg desc "$INTERNAL_DESC" \
        '[.[] | select(.description != $desc and .disabled != true and .name != "FALLBACK")][0].name // empty' || true
}

wanted_position() {
    if drm_has_external; then
        printf '%s\n' "$INTERNAL_POSITION"
    else
        printf '%s\n' '0x0'
    fi
}

should_force_on() {
    if ! drm_has_external; then
        return 0
    fi
    [[ -z "$(get_other_monitor)" ]]
}

get_preference() {
    if [[ -f "$STATE_FILE" && $(<"$STATE_FILE") == "off" ]]; then
        echo "off"
    else
        echo "on"
    fi
}

set_preference() {
    mkdir -p "$STATE_DIR"
    echo "$1" > "$STATE_FILE"
}

monitor_spec() {
    local name="$1" position="$2"
    local cmd="$name,$INTERNAL_MODE,$position,$INTERNAL_SCALE"
    if [[ -n "$INTERNAL_TRANSFORM" && "$INTERNAL_TRANSFORM" != "0" ]]; then
        cmd="$cmd,transform,$INTERNAL_TRANSFORM"
    fi
    printf '%s\n' "$cmd"
}

restart_bar() {
    command -v waybar >/dev/null 2>&1 || return 0
    hyprctl dispatch exec "pkill waybar; waybar" >/dev/null 2>&1 || true
}

enable_internal() {
    local name position xy result
    name=$(get_monitor_name) || {
        echo "Error: Internal monitor not found" >&2
        return 1
    }
    position=$(wanted_position)
    xy=$(internal_xy)
    if is_enabled && [[ "$xy" == "$position" ]]; then
        return 0
    fi

    echo "Enabling internal monitor: $name at $position"
    result=$(hyprctl keyword monitor "$(monitor_spec "$name" "$position")" 2>&1 || true)
    echo "$result"
    sleep 0.2
    if is_enabled && [[ "$(internal_xy)" == "$position" ]]; then
        restart_bar
        return 0
    fi
    return 1
}

disable_internal() {
    local name other result
    name=$(get_monitor_name) || {
        echo "Error: Internal monitor not found" >&2
        return 1
    }
    if should_force_on; then
        echo "Internal monitor stays on (no other monitor). Will disable when an external is attached."
        return 0
    fi
    other=$(get_other_monitor)

    echo "Disabling internal monitor: $name"
    hyprctl workspaces -j 2>/dev/null | jq -r --arg mon "$name" \
        '.[] | select(.monitor == $mon) | .id' | while read -r ws; do
        [[ -n "$ws" ]] && hyprctl dispatch moveworkspacetomonitor "$ws" "$other" >/dev/null || true
    done
    hyprctl dispatch focusmonitor "$other" >/dev/null || true
    result=$(hyprctl keyword monitor "$name,disable" 2>&1 || true)
    echo "$result"
    restart_bar
}

apply_internal() {
    if should_force_on; then
        enable_internal || true
        return 0
    fi
    if [[ "$(get_preference)" == "off" ]]; then
        if is_enabled; then
            disable_internal || true
        fi
    else
        enable_internal || true
    fi
}

watch_internal() {
    mkdir -p "$STATE_DIR"
    exec 9>"$WATCH_LOCK"
    flock -n 9 || exit 0
    trap 'kill $(jobs -p) 2>/dev/null || true' EXIT

    apply_internal || true
    udevadm monitor --udev --subsystem-match=drm | while read -r _; do
        apply_internal || true
    done &

    while true; do
        sleep 1
        apply_internal || true
    done
}

show_status() {
    echo "Preference: $(get_preference)"
    if is_enabled; then
        echo "Monitor: ENABLED at $(internal_xy)"
    else
        echo "Monitor: DISABLED"
    fi
}

ACTION="toggle"
for arg in "$@"; do
    case "$arg" in
        on|off|toggle|status|apply|watch)
            ACTION="$arg"
            ;;
        *)
            echo "Usage: $0 [on|off|toggle|status|apply|watch]"
            exit 1
            ;;
    esac
done

case "$ACTION" in
    on)
        set_preference on
        enable_internal
        ;;
    off)
        set_preference off
        disable_internal
        ;;
    toggle)
        if is_enabled; then
            set_preference off
            disable_internal
        else
            set_preference on
            enable_internal
        fi
        ;;
    apply)
        apply_internal
        ;;
    watch)
        watch_internal
        ;;
    status)
        show_status
        ;;
esac

