#!/usr/bin/env bash

# Daily generated wallpapers per monitor.
# Placeholders are substituted by the Home Manager module.

set -euo pipefail

HOST='@HOST@'
MONITORS_JSON='@MONITORS_JSON@'
DOMAIN_FILE='@DOMAIN_FILE@'
SUBDOMAIN='@SUBDOMAIN@'
PALETTE='@PALETTE@'
FALLBACK='@FALLBACK@'

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-rotate"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallpaper-rotate"
STATE_FILE="$STATE_DIR/state.json"
LOCK_FILE="$STATE_DIR/lock"

usage() {
    cat <<'EOF'
Usage: wallpaper-rotate [apply]
       wallpaper-rotate reroll [--monitor internal|external]
       wallpaper-rotate watch
       wallpaper-rotate status

apply     Fetch (if needed) and set today's wallpaper on every connected output.
reroll    Bump the reroll counter and apply. Default: every connected monitor.
          --monitor internal|external bumps that role even if it is disconnected.
watch     Apply once, then re-apply when an output is added or resized.
EOF
}

today() {
    date +%F
}

ensure_dirs() {
    mkdir -p "$STATE_DIR" "$CACHE_DIR"
}

default_state() {
    jq -n --arg d "$(today)" '{date: $d, reroll: {internal: 0, external: 0}}'
}

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        default_state
    fi
}

write_state() {
    local tmp
    tmp=$(mktemp "$STATE_DIR/state.XXXXXX")
    cat >"$tmp"
    mv "$tmp" "$STATE_FILE"
}

ensure_date() {
    local current
    current=$(read_state | jq -r '.date')
    if [[ "$current" != "$(today)" ]]; then
        default_state | write_state
    fi
}

reroll_of() {
    local role="$1"
    read_state | jq -r --arg r "$role" '.reroll[$r] // 0'
}

bump_role() {
    local role="$1"
    read_state | jq --arg r "$role" '.reroll[$r] = ((.reroll[$r] // 0) + 1)' | write_state
}

seed_for() {
    local role="$1"
    printf '%s|%s|%s|reroll:%s\n' "$HOST" "$role" "$(today)" "$(reroll_of "$role")"
}

cache_path() {
    local seed="$1" width="$2" height="$3"
    local slug
    slug=${seed//\//_}
    printf '%s/%s_%sx%s.png\n' "$CACHE_DIR" "$slug" "$width" "$height"
}

is_png() {
    local f="$1" magic
    [[ -s "$f" ]] || return 1
    # od, not $(head): command substitution strips the trailing 0x0a of the PNG signature.
    magic=$(od -An -tx1 -N8 "$f" | tr -d ' \n')
    [[ "$magic" == 89504e470d0a1a0a ]]
}

endpoint() {
    local domain
    if [[ ! -s "$DOMAIN_FILE" ]]; then
        echo "wallpaper-rotate: domain secret missing at $DOMAIN_FILE" >&2
        return 1
    fi
    domain=$(tr -d '[:space:]' <"$DOMAIN_FILE")
    if [[ -z "$domain" ]]; then
        echo "wallpaper-rotate: domain secret is empty" >&2
        return 1
    fi
    printf 'https://%s.%s/grid\n' "$SUBDOMAIN" "$domain"
}

fetch_png() {
    local dest="$1" seed="$2" width="$3" height="$4"
    local url payload tmp
    url=$(endpoint) || return 1
    payload=$(jq -n \
        --arg seed "$seed" \
        --arg pal "$PALETTE" \
        --argjson w "$width" \
        --argjson h "$height" \
        '{seed: $seed, width: $w, height: $h, palette: $pal}')
    tmp=$(mktemp "$CACHE_DIR/fetch.XXXXXX")
    if ! curl -fsS --max-time 120 -o "$tmp" \
        -X POST "$url" \
        -H 'Content-Type: application/json' \
        -d "$payload"
    then
        rm -f "$tmp"
        return 1
    fi
    if ! is_png "$tmp"; then
        echo "wallpaper-rotate: response was not a PNG ($(od -An -tx1 -N8 "$tmp" | tr -s ' '))" >&2
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$dest"
}

wait_for_awww() {
    local i
    for i in $(seq 1 50); do
        if awww query >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.2
    done
    echo "wallpaper-rotate: awww daemon is not ready" >&2
    return 1
}

desktop() {
    case "${XDG_CURRENT_DESKTOP:-}" in
        niri*) printf 'niri\n' ;;
        Hyprland|hyprland) printf 'hyprland\n' ;;
        *)
            if [[ -n "${NIRI_SOCKET:-}" ]]; then
                printf 'niri\n'
            elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
                printf 'hyprland\n'
            else
                printf 'unknown\n'
            fi
            ;;
    esac
}

internal_role_jq() {
    # $map.internal is {name, connector} or null.
    printf '%s' '(
        if $map.internal == null then "external"
        elif ($map.internal.connector != null and .name == $map.internal.connector)
            or (.description == $map.internal.name)
            then "internal"
        else "external"
        end
    )'
}

# Connected outputs mapped to metadata roles. Columns: name role width height
list_outputs() {
    local json
    case "$(desktop)" in
        hyprland)
            json=$(hyprctl monitors -j 2>/dev/null) || json='[]'
            printf '%s\n' "$json" | jq -r --argjson map "$MONITORS_JSON" '
                .[]
                | select(.disabled != true and .name != "FALLBACK")
                | . as $m
                | $m
                | '"$(internal_role_jq)"' as $role
                | "\($m.name)\t\($role)\t\($m.width)\t\($m.height)"
            '
            ;;
        niri)
            json=$(niri msg --json outputs 2>/dev/null) || json='{}'
            printf '%s\n' "$json" | jq -r --argjson map "$MONITORS_JSON" '
                to_entries[].value
                | select(.logical != null)
                | . as $m
                | ([.make, .model, .serial] | map(select(. != null and . != "")) | join(" ")) as $desc
                | ($m + {description: $desc})
                | '"$(internal_role_jq)"' as $role
                | "\($m.name)\t\($role)\t\($m.logical.width)\t\($m.logical.height)"
            '
            ;;
        *)
            echo "wallpaper-rotate: unknown compositor" >&2
            return 1
            ;;
    esac
}

connected_roles() {
    list_outputs | cut -f2 | sort -u
}

set_output() {
    local name="$1" png="$2"
    awww img --outputs "$name" "$png"
}

ensure_png() {
    local role="$1" width="$2" height="$3"
    local seed dest
    seed=$(seed_for "$role")
    dest=$(cache_path "$seed" "$width" "$height")
    if is_png "$dest"; then
        printf '%s\n' "$dest"
        return 0
    fi
    if fetch_png "$dest" "$seed" "$width" "$height"; then
        printf '%s\n' "$dest"
        return 0
    fi
    echo "wallpaper-rotate: fetch failed for $role (${width}x${height})" >&2
    if [[ -n "$FALLBACK" && -f "$FALLBACK" ]]; then
        printf '%s\n' "$FALLBACK"
        return 0
    fi
    return 1
}

apply_all() {
    ensure_dirs
    ensure_date
    wait_for_awww || return 1
    local line name role width height png
    local any=0
    while IFS=$'\t' read -r name role width height; do
        [[ -n "$name" ]] || continue
        if ! [[ "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]]; then
            echo "wallpaper-rotate: skip $name (no logical size yet)" >&2
            continue
        fi
        if png=$(ensure_png "$role" "$width" "$height"); then
            set_output "$name" "$png"
            echo "wallpaper-rotate: $name ($role) <- $png"
            any=1
        fi
    done < <(list_outputs)
    if [[ "$any" -eq 0 ]]; then
        echo "wallpaper-rotate: no mapped outputs to paint" >&2
        return 1
    fi
}

with_lock() {
    ensure_dirs
    (
        flock 9
        "$@"
    ) 9>"$LOCK_FILE"
}

do_reroll() {
    local target="${1:-}"
    ensure_dirs
    ensure_date
    local role
    if [[ -n "$target" ]]; then
        if [[ "$target" != "internal" && "$target" != "external" ]]; then
            echo "wallpaper-rotate: --monitor must be internal or external" >&2
            return 2
        fi
        bump_role "$target"
    else
        local roles
        roles=$(connected_roles)
        if [[ -z "$roles" ]]; then
            echo "wallpaper-rotate: no mapped outputs to reroll" >&2
            return 1
        fi
        while IFS= read -r role; do
            [[ -n "$role" ]] || continue
            bump_role "$role"
        done <<<"$roles"
    fi
    apply_all
}

do_watch() {
    local prev="" cur
    while true; do
        cur=$(list_outputs 2>/dev/null | sort | tr '\n' '|') || cur=""
        if [[ "$cur" != "$prev" ]]; then
            with_lock apply_all || true
            prev=$cur
        fi
        sleep 1
    done
}

do_status() {
    ensure_dirs
    ensure_date
    echo "date:    $(read_state | jq -r '.date')"
    echo "reroll:  internal=$(reroll_of internal) external=$(reroll_of external)"
    echo "outputs:"
    local name role width height seed
    if ! list_outputs | grep -q .; then
        echo "  (none mapped)"
        return 0
    fi
    while IFS=$'\t' read -r name role width height; do
        seed=$(seed_for "$role")
        echo "  $name  role=$role  ${width}x${height}"
        echo "    seed=$seed"
        echo "    cache=$(cache_path "$seed" "$width" "$height")"
    done < <(list_outputs)
}

ACTION=apply
MONITOR_ROLE=

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        apply|watch|status|reroll)
            ACTION="$1"
            shift
            ;;
        --monitor)
            if [[ $# -lt 2 ]]; then
                echo "wallpaper-rotate: --monitor needs internal or external" >&2
                exit 2
            fi
            MONITOR_ROLE="$2"
            shift 2
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ -n "$MONITOR_ROLE" && "$ACTION" != "reroll" ]]; then
    echo "wallpaper-rotate: --monitor is only valid with reroll" >&2
    exit 2
fi

case "$ACTION" in
    apply)
        with_lock apply_all
        ;;
    reroll)
        with_lock do_reroll "$MONITOR_ROLE"
        ;;
    watch)
        do_watch
        ;;
    status)
        do_status
        ;;
esac
