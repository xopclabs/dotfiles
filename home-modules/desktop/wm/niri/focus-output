set -euo pipefail

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "Usage: niri-focus-output <output-or-description> [fallback ...]" >&2
    exit 1
fi

targets=("$@")
outputs_json="$(niri msg --json outputs)"
focused=$(niri msg --json focused-output | jq -r '.name // empty')

target=""
for candidate in "${targets[@]}"; do
    target="$(jq -n -r \
        --argjson outputs "$outputs_json" \
        --arg target "$candidate" '
        def desc:
          [.make, .model, .serial]
          | map(select(. != null and . != "") | gsub("\\s+$"; ""))
          | join(" ");
        first($outputs | to_entries[]
            | select(.key == $target or (.value | desc) == $target)
            | .key)
        // empty
    ')"
    [[ -n "$target" ]] && break
done

if [[ -z "$target" ]]; then
    target="${targets[0]}"
fi

is_target_focused=0
for t in "${targets[@]}"; do
    if [[ "$focused" == "$t" || "$focused" == "$target" ]]; then
        is_target_focused=1
        break
    fi
done

if [[ "$is_target_focused" != 1 ]]; then
    niri msg action focus-monitor "$target"
    exit 0
fi

next=$(jq -n -r \
    --arg out "$target" \
    --argjson workspaces "$(niri msg --json workspaces)" \
    --argjson windows "$(niri msg --json windows)" '
    ($windows | map(.workspace_id) | unique) as $occupied
    | [$workspaces[] | select(.output == $out and (.id | IN($occupied[])))]
    | sort_by(.idx)
    | (map(.is_active) | index(true)) as $cur
    | if length == 0 then empty
      elif $cur == null then .[0].idx
      elif length == 1 then empty
      else .[($cur + 1) % length].idx
      end
')

if [[ -n "$next" ]]; then
    niri msg action focus-workspace "$next"
fi
