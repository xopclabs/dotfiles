(defpoll co2_data :interval "60s" :initial "{\"chart\":\"@EMPTY_CHART@\",\"high\":\"—\",\"low\":\"—\",\"legend1\":\"—\",\"legend2\":\"\",\"period\":\"1h\"}"
  `eww-dashboard-query co2`)
(defpoll temperature_data :interval "60s" :initial "{\"chart\":\"@EMPTY_CHART@\",\"high\":\"—\",\"low\":\"—\",\"legend1\":\"—\",\"legend2\":\"\",\"period\":\"1h\"}"
  `eww-dashboard-query temperature`)
(defpoll power_data :interval "60s" :initial "{\"chart\":\"@EMPTY_CHART@\",\"high\":\"—\",\"low\":\"—\",\"legend1\":\"—\",\"legend2\":\"\",\"period\":\"1h\"}"
  `eww-dashboard-query power`)
(defpoll humidity_data :interval "60s" :initial "{\"value\":\"—\",\"color\":\"#d8dee9\"}" `eww-dashboard-query humidity`)
(defpoll today_power_data :interval "60s" :initial "{\"value\":\"—\",\"color\":\"#d8dee9\"}" `eww-dashboard-query today_power`)
(defpoll co2_value :interval "60s" :initial "{\"value\":\"—\",\"color\":\"#d8dee9\"}" `eww-dashboard-query co2_value`)

(defwidget chart-tile [title icon data key plot_width]
  (box :class "tile chart-tile" :orientation "vertical" :space-evenly false
    (box :class "header" :space-evenly false
      (box :class "title" :hexpand true :space-evenly false
        (image :class "tile-icon" :path icon :image-width 18 :image-height 18)
        (label :text title))
      (eventbox :class "period-click" :onclick "eww-dashboard-period ${key}"
        (label :class "period" :text "${data.period}")))
    (box :class "graph" :orientation "horizontal" :space-evenly false
      (box :class "axis" :orientation "vertical" :space-evenly false
        (label :text {data.high})
        (label :class "axis-bottom" :text {data.low}))
      (image :path {data.chart} :image-width plot_width :image-height 88))
    (box :class "legend" :space-evenly false
      (label :class "series-one" :text {data.legend1})
      (box :hexpand true)
      (label :class "series-two" :visible {data.legend2 != ""} :text {data.legend2}))))

(defwidget value-tile [title icon data kind]
  (box :class "tile value-tile ${kind}" :orientation "vertical" :space-evenly false
    (box :class "value-title" :halign "center" :space-evenly false
      (image :class "tile-icon" :path icon :image-width 18 :image-height 18)
      (label :text title))
    (label :class "reading" :halign "center" :style "color: ${data.color};" :text {data.value})))

(defwindow co2_chart
  :monitor "eDP-1"
  :geometry (geometry :x "16px" :y "14px" :width "320px" :height "160px" :anchor "top left")
  :stacking "bottom" :namespace "eww-telemetry-co2"
  (chart-tile :title "CO₂" :icon "@ICONS@/lungs.png" :data co2_data :key "co2" :plot_width 264))

(defwindow temperature_chart
  :monitor "eDP-1"
  :geometry (geometry :x "352px" :y "14px" :width "384px" :height "160px" :anchor "top left")
  :stacking "bottom" :namespace "eww-telemetry-temperature"
  (chart-tile :title "Temperature" :icon "@ICONS@/temperature.png" :data temperature_data :key "temperature" :plot_width 328))

(defwindow humidity_value
  :monitor "eDP-1"
  :geometry (geometry :x "752px" :y "14px" :width "192px" :height "160px" :anchor "top left")
  :stacking "bottom" :namespace "eww-telemetry-humidity"
  (value-tile :title "Humidity" :icon "@ICONS@/droplet.png" :data humidity_data :kind "humidity"))

(defwindow today_power
  :monitor "eDP-1"
  :geometry (geometry :x "16px" :y "190px" :width "192px" :height "160px" :anchor "top left")
  :stacking "bottom" :namespace "eww-telemetry-energy"
  (value-tile :title "Energy" :icon "@ICONS@/bolt.png" :data today_power_data :kind "energy"))

(defwindow power_chart
  :monitor "eDP-1"
  :geometry (geometry :x "224px" :y "190px" :width "416px" :height "160px" :anchor "top left")
  :stacking "bottom" :namespace "eww-telemetry-power"
  (chart-tile :title "Active power" :icon "@ICONS@/plug.png" :data power_data :key "power" :plot_width 360))

(defwindow dashboard
  :monitor "eDP-1"
  :geometry (geometry :x "16px" :y "14px" :width "192px" :height "160px" :anchor "top left")
  :stacking "bottom" :namespace "eww-telemetry-current"
  (value-tile :title "CO₂" :icon "@ICONS@/lungs.png" :data co2_value :kind "co2"))
