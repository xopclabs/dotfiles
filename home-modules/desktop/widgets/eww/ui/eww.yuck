(defwidget chart-tile [title icon data key plot_width header_alignment]
  (box :class "tile chart-tile" :orientation "vertical" :space-evenly false
    (box :class "header" :hexpand true :space-evenly false
      (box :class "title-slot" :hexpand true
        (box :class "title" :hexpand true :halign {header_alignment == "center" ? "center" : "start"} :space-evenly false
          (image :class "tile-icon" :path icon :image-width 18 :image-height 18)
          (label :text title)))
      (eventbox :class "period-click" :onclick "eww-dashboard-period ${key}"
        (label :class "period" :text "${data.period}")))
    (box :class "graph" :orientation "horizontal" :space-evenly false
      (box :class "axis" :orientation "vertical" :space-evenly false
        (label :text {data.high})
        (label :class "axis-bottom" :text {data.low}))
      (image :path {data.chart} :image-width plot_width :image-height 84))
    (box :class "legend" :space-evenly false
      (label :class "series-one" :text {data.legend1})
      (box :hexpand true)
      (label :class "series-two" :visible {data.legend2 != ""} :text {data.legend2}))))

(defwidget value-tile [title icon data compact header_alignment]
  (box :class {compact ? "tile value-tile compact" : "tile value-tile"} :orientation "vertical" :space-evenly false
    (centerbox :class "header" :orientation "horizontal" :hexpand true
      (box :class "title" :visible {header_alignment == "left"} :space-evenly false
        (image :class "tile-icon" :path icon :image-width 18 :image-height 18)
        (label :text title))
      (box :class "title" :visible {header_alignment == "center"} :space-evenly false
        (image :class "tile-icon" :path icon :image-width 18 :image-height 18)
        (label :text title))
      (box))
    (label :class "reading" :hexpand true :vexpand true :halign "center" :valign "center"
      :style "color: ${data.color};" :text {data.value})))

