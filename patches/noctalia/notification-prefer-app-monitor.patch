+bool NotificationToast::entryHasPresentTarget(const PopupEntry& entry) const {
+  if (entry.targetOutputNames.empty() || m_wayland == nullptr) {
+    return false;
+  }
+  return std::ranges::any_of(m_wayland->outputs(), [&entry](const WaylandOutput& output) {
+    return output.done && output.output != nullptr && output.hasUsableGeometry()
+        && outputNameInList(output, entry.targetOutputNames);
+  });
+}
+
+bool NotificationToast::entryTargetsOutput(const PopupEntry& entry, const WaylandOutput& output) const {
+  if (entryHasPresentTarget(entry)) {
+    return outputNameInList(output, entry.targetOutputNames);
+  }
+  return shouldRenderOnOutput(output);
+}
+
+bool NotificationToast::entriesMayShareOutput(const PopupEntry& a, const PopupEntry& b) const {
+  if (m_wayland == nullptr) {
+    return true;
+  }
+  return std::ranges::any_of(m_wayland->outputs(), [this, &a, &b](const WaylandOutput& output) {
+    return output.done && output.output != nullptr && output.hasUsableGeometry() && entryTargetsOutput(a, output)
+        && entryTargetsOutput(b, output);
+  });
+}
+
+bool NotificationToast::outputNeededForNotifications(const WaylandOutput& output, bool anyConfiguredPresent) const {
+  bool needsDefaultRoute = m_entries.empty();
+  for (const auto& entry : m_entries) {
+    if (entry.exiting) {
+      continue;
+    }
+    if (entryHasPresentTarget(entry)) {
+      if (outputNameInList(output, entry.targetOutputNames)) {
+        return true;
+      }
+    } else {
+      needsDefaultRoute = true;
+    }
+  }
+  return needsDefaultRoute && (!anyConfiguredPresent || shouldRenderOnOutput(output));
+}
