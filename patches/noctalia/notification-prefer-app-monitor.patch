+std::vector<std::string> NotificationToast::appOutputNamesForNotification(const Notification& notification) const {
+  if (m_config == nullptr || !m_config->config().notification.preferAppMonitor || m_platform == nullptr) {
+    return {};
+  }
+
+  const auto tokens = notificationAppMatchTokens(notification);
+  if (tokens.empty()) {
+    return {};
+  }
+
+  std::vector<std::string> outputNames;
+  for (const auto& output : m_platform->outputs()) {
+    if (!output.done || output.output == nullptr || !output.hasUsableGeometry()) {
+      continue;
+    }
+
+    const auto assignments = m_platform->workspaceWindowAssignments(output.output);
+    const bool hasMatchingWindow = std::ranges::any_of(assignments, [&tokens](const WorkspaceWindowAssignment& window) {
+      return appIdMatchesAnyToken(window.appId, tokens);
+    });
+    if (hasMatchingWindow && !std::ranges::contains(outputNames, output.connectorName)) {
+      outputNames.push_back(output.connectorName);
+    }
+  }
+  return outputNames;
+}
