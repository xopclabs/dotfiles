+    const std::string normalized = normalizedAppId(appId);
+    if (normalized.empty()) {
+      return false;
+    }
+    return std::ranges::any_of(tokens, [&normalized](const std::string& token) {
+      return normalized == token
+          || (normalized.size() > token.size() && normalized.ends_with(std::string(".") + token))
+          || (token.size() > normalized.size() && token.ends_with(std::string(".") + normalized));
+    });
+  }
