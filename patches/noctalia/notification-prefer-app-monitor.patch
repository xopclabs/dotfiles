+  std::vector<std::string> notificationAppMatchTokens(const Notification& notification) {
+    std::vector<std::string> tokens;
+    auto addToken = [&tokens](std::string_view raw) {
+      std::string token = normalizedAppId(raw);
+      if (!token.empty() && !std::ranges::contains(tokens, token)) {
+        tokens.push_back(std::move(token));
+      }
+    };
