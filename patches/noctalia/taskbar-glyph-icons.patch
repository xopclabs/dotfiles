+std::string TaskbarWidget::resolveIconGlyph(const TaskModel& task) const {
+  const auto& map = m_configOptions.iconGlyphs;
+  if (!task.title.empty()) {
+    const std::string titleLower = toLower(task.title);
+    for (const auto& [key, glyph] : map) {
+      if (key.starts_with("title:") && key.size() > 6) {
+        const std::string needle = toLower(key.substr(6));
+        if (!needle.empty() && titleLower.find(needle) != std::string::npos) {
+          return glyph;
+        }
+      }
+    }
+  }
+  const auto lookup = [&](const std::string& key) -> std::string {
+    if (key.empty()) {
+      return {};
+    }
+    const auto it = map.find(key);
+    return it != map.end() ? it->second : std::string{};
+  };
+  if (const std::string glyph = lookup(task.appIdLower); !glyph.empty()) {
+    return glyph;
+  }
+  if (const std::string glyph = lookup(task.idLower); !glyph.empty()) {
+    return glyph;
+  }
+  if (const std::string glyph = lookup(task.startupWmClassLower); !glyph.empty()) {
+    return glyph;
+  }
+  if (const std::string glyph = lookup(toLower(task.desktopEntryId)); !glyph.empty()) {
+    return glyph;
+  }
+  return {};
+}
+
+void TaskbarWidget::appendTaskIcon(Flex& content, Renderer& renderer, const TaskModel& task, float iconSize) {
+  const ColorSpec color =
+      m_configService.config().shell.appIconColor.value_or(colorSpecFromRole(ColorRole::OnSurface));
+  const std::string mapped = resolveIconGlyph(task);
+  if (mapped.empty() && m_configOptions.iconUnmapped == TaskbarIconUnmapped::App && !task.iconPath.empty()) {
+    auto image = ui::image({
+        .fit = ImageFit::Contain,
+        .width = iconSize,
+        .height = iconSize,
+    });
+    image->setAppIconColorization(color);
+    image->setSourceFile(renderer, task.iconPath, static_cast<int>(std::round(iconSize)), true);
+    if (image->hasImage()) {
+      content.addChild(std::move(image));
+      return;
+    }
+  }
+  const std::string name = !mapped.empty() ? mapped : m_configOptions.iconGlyphDefault;
+  if (isTablerIconName(name)) {
+    auto glyph = ui::glyph({
+        .glyph = name,
+        .glyphSize = iconSize,
+        .color = color,
+    });
+    glyph->measure(renderer);
+    content.addChild(std::move(glyph));
+    return;
+  }
+  auto label = ui::label({
+      .text = name,
+      .fontSize = iconSize,
+      .fontFamily = labelFontFamily(),
+      .color = color,
+      .width = iconSize,
+      .height = iconSize,
+      .maxLines = 1,
+      .textAlign = TextAlign::Center,
+      .baselineMode = LabelBaselineMode::InkCentered,
+  });
+  label->measure(renderer);
+  content.addChild(std::move(label));
+}
