+void HomeTab::parseCodexJson(const std::string& jsonStr) {
+  if (jsonStr.empty()) {
+    return;
+  }
+  try {
+    auto root = nlohmann::json::parse(jsonStr);
+    const nlohmann::json* item = nullptr;
+    if (root.is_array() && !root.empty()) {
+      for (const auto& el : root) {
+        if (el.is_object() && el.value("provider", "") == "codex") {
+          item = &el;
+          break;
+        }
+      }
+      if (item == nullptr && root[0].is_object()) {
+        item = &root[0];
+      }
+    } else if (root.is_object()) {
+      item = &root;
+    }
+
+    if (item != nullptr) {
+      m_codexData.hasData = true;
+      m_codexData.error.clear();
+
+      const auto& usage = item->contains("usage") && (*item)["usage"].is_object() ? (*item)["usage"] : *item;
+
+      m_codexData.accountEmail = usage.value("accountEmail", item->value("account", ""));
+      m_codexData.loginMethod = usage.value("loginMethod", item->value("loginMethod", ""));
+
+      if (usage.contains("primary") && usage["primary"].is_object()) {
+        const auto& p = usage["primary"];
+        m_codexData.primary.title = "5-Hour Limit";
+        m_codexData.primary.usedPercent = p.value("usedPercent", 0.0F);
+        m_codexData.primary.resetDesc = p.value("resetDescription", "");
+        m_codexData.primary.resetsAt = p.value("resetsAt", "");
+      }
+
+      if (usage.contains("secondary") && usage["secondary"].is_object()) {
+        const auto& s = usage["secondary"];
+        m_codexData.secondary.title = "Weekly Limit";
+        m_codexData.secondary.usedPercent = s.value("usedPercent", 0.0F);
+        m_codexData.secondary.resetDesc = s.value("resetDescription", "");
+        m_codexData.secondary.resetsAt = s.value("resetsAt", "");
+      }
+
+      if (item->contains("pace") && (*item)["pace"].is_object()) {
+        const auto& pace = (*item)["pace"];
+        if (pace.contains("secondary") && pace["secondary"].is_object()) {
+          const auto& ps = pace["secondary"];
+          std::string summary = ps.value("summary", "");
+          if (!summary.empty()) {
+            auto barPos = summary.find('|');
+            if (barPos != std::string::npos) {
+              summary = summary.substr(0, barPos);
+              while (!summary.empty() && summary.back() == ' ') {
+                summary.pop_back();
+              }
+            }
+            m_codexData.paceSummary = summary;
+          }
+        }
+      }
+
+      m_codexData.updatedAt = "Updated";
+    }
+  } catch (...) {
+  }
+}
+
+void HomeTab::refreshCodexUsage(bool force) {
+  if (m_codexFetchInFlight) {
+    return;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (!force && m_lastCodexFetch != std::chrono::steady_clock::time_point{} &&
+      (now - m_lastCodexFetch) < std::chrono::seconds(60)) {
+    return;
+  }
+
+  m_codexFetchInFlight = true;
+  if (m_codexUpdatedLabel != nullptr) {
+    m_codexUpdatedLabel->setText("Refreshing…");
+  }
+
+  process::RunOptions options;
+  options.timeout = std::chrono::milliseconds(30000);
+  process::RunCallbacks callbacks;
+  callbacks.onExit = [this](process::RunResult res) {
+    DeferredCall::callLater([this, exitCode = res.exitCode, out = std::move(res.out)]() {
+      m_codexFetchInFlight = false;
+      m_lastCodexFetch = std::chrono::steady_clock::now();
+      if (exitCode == 0 && !out.empty()) {
+        parseCodexJson(out);
+        scripting::PluginStateStore::instance().set("salemsayed/codexbar-meter", "providers", out);
+        if (const char* home = std::getenv("HOME"); home != nullptr) {
+          std::filesystem::path cachePath = std::filesystem::path(home) / ".cache/noctalia/codexbar_cache.json";
+          std::error_code ec;
+          std::filesystem::create_directories(cachePath.parent_path(), ec);
+          std::ofstream f(cachePath);
+          if (f.is_open()) {
+            f << out;
+          }
+        }
+        syncCodexCard();
+      } else {
+        if (m_codexUpdatedLabel != nullptr) {
+          m_codexUpdatedLabel->setText(m_codexData.hasData ? "Refresh failed" : "Error");
+        }
+      }
+      PanelManager::instance().requestRedraw();
+    });
+  };
+
+  const std::string cmd = "codexbar usage --format json --json-only";
+  if (!process::runAsync(cmd, std::move(callbacks), options)) {
+    m_codexFetchInFlight = false;
+    if (m_codexUpdatedLabel != nullptr) {
+      m_codexUpdatedLabel->setText("Command failed");
+    }
+  }
+}
+
+void HomeTab::syncCodexCard() {
+  if (m_codexCard == nullptr) {
+    return;
+  }
+  if (!m_codexData.hasData) {
+    if (m_codexAccountLabel != nullptr) {
+      m_codexAccountLabel->setText("Loading…");
+    }
+    return;
+  }
+
+  if (m_codexAccountLabel != nullptr) {
+    std::string acc = m_codexData.accountEmail;
+    if (!m_codexData.loginMethod.empty()) {
+      std::string m = m_codexData.loginMethod;
+      if (!m.empty()) {
+        m[0] = static_cast<char>(std::toupper(static_cast<unsigned char>(m[0])));
+      }
+      acc += " (" + m + ")";
+    }
+    m_codexAccountLabel->setText(acc);
+  }
+
+  if (m_codexUpdatedLabel != nullptr && !m_codexFetchInFlight) {
+    m_codexUpdatedLabel->setText(m_codexData.updatedAt);
+  }
+
+  if (m_codex5hInfoLabel != nullptr) {
+    std::string resetStr = m_codexData.primary.resetDesc.empty() ? "" : " · Resets " + m_codexData.primary.resetDesc;
+    m_codex5hInfoLabel->setText(std::format("{:.0F}% used{}", m_codexData.primary.usedPercent, resetStr));
+  }
+  if (m_codex5hProgress != nullptr) {
+    const float pct = std::clamp(m_codexData.primary.usedPercent / 100.0F, 0.0F, 1.0F);
+    m_codex5hProgress->setProgress(pct);
+    if (m_codexData.primary.usedPercent >= 90.0F) {
+      m_codex5hProgress->setFill(colorSpecFromRole(ColorRole::Error));
+    } else if (m_codexData.primary.usedPercent >= 75.0F) {
+      m_codex5hProgress->setFill(colorSpecFromRole(ColorRole::Tertiary));
+    } else {
+      m_codex5hProgress->setFill(colorSpecFromRole(ColorRole::Primary));
+    }
+  }
+
+  if (m_codexWeeklyInfoLabel != nullptr) {
+    std::string resetStr = m_codexData.secondary.resetDesc.empty() ? "" : " · Resets " + m_codexData.secondary.resetDesc;
+    m_codexWeeklyInfoLabel->setText(std::format("{:.0F}% used{}", m_codexData.secondary.usedPercent, resetStr));
+  }
+  if (m_codexWeeklyProgress != nullptr) {
+    const float pct = std::clamp(m_codexData.secondary.usedPercent / 100.0F, 0.0F, 1.0F);
+    m_codexWeeklyProgress->setProgress(pct);
+    if (m_codexData.secondary.usedPercent >= 90.0F) {
+      m_codexWeeklyProgress->setFill(colorSpecFromRole(ColorRole::Error));
+    } else if (m_codexData.secondary.usedPercent >= 75.0F) {
+      m_codexWeeklyProgress->setFill(colorSpecFromRole(ColorRole::Tertiary));
+    } else {
+      m_codexWeeklyProgress->setFill(colorSpecFromRole(ColorRole::Secondary));
+    }
+  }
+
+  if (m_codexPaceLabel != nullptr) {
+    if (!m_codexData.paceSummary.empty()) {
+      m_codexPaceLabel->setText("Pace: " + m_codexData.paceSummary);
+    } else {
+      m_codexPaceLabel->setText("Status: Active");
+    }
+  }
+}
