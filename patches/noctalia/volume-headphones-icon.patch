+  [[nodiscard]] char asciiLower(char c) {
+    return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c;
+  }
+
+  [[nodiscard]] bool containsIgnoreCase(std::string_view hay, std::string_view needle) {
+    if (needle.empty() || hay.size() < needle.size()) {
+      return false;
+    }
+    const auto pred = [](char a, char b) { return asciiLower(a) == asciiLower(b); };
+    return std::ranges::search(hay, needle, pred).begin() != hay.end();
+  }
+
+  [[nodiscard]] bool looksLikeHeadphoneText(std::string_view text) {
+    return containsIgnoreCase(text, "headphone")
+        || containsIgnoreCase(text, "headset")
+        || containsIgnoreCase(text, "earbud")
+        || containsIgnoreCase(text, "earphone");
+  }
+
 } // namespace
 
