+#include <string.h>
 #include <unistd.h>
 
+static bool find_builtin_drm(char *drm_path, size_t drm_path_size, int64_t *connector_id) {
+    DIR *dir = opendir("/sys/class/drm");
+    if (!dir)
+        return false;
+
+    struct dirent *entry;
+    while ((entry = readdir(dir))) {
+        if (strncmp(entry->d_name, "card", 4) != 0)
+            continue;
+
+        char *connector_name;
+        long card = strtol(entry->d_name + 4, &connector_name, 10);
+        if (connector_name == entry->d_name + 4 || strncmp(connector_name, "-eDP-", 5) != 0)
+            continue;
+
+        char connector_id_path[256];
+        snprintf(connector_id_path, sizeof(connector_id_path),
+                 "/sys/class/drm/%s/connector_id", entry->d_name);
+
+        FILE *connector_id_file = fopen(connector_id_path, "r");
+        long long id;
+        if (!connector_id_file || fscanf(connector_id_file, "%lld", &id) != 1) {
+            if (connector_id_file)
+                fclose(connector_id_file);
+            continue;
+        }
+        fclose(connector_id_file);
+
+        snprintf(drm_path, drm_path_size, "/dev/dri/card%ld", card);
+        if (access(drm_path, F_OK) != 0)
+            continue;
+
+        *connector_id = id;
+        closedir(dir);
+        return true;
+    }
+
+    closedir(dir);
+    return false;
+}
